# Environment Configuration for Autonomous AI Scientist
APP_ENV=development
PORT=8000
HOST=127.0.0.1
DEBUG=true

# Database Settings
DATABASE_URL=sqlite+aiosqlite:///data/cache/scientific_memory.db

# Research Parameters
RANDOM_SEED=42
DEVICE=cpu

# Optional External API Keys (Leave blank for offline mode)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
MATERIALS_PROJECT_API_KEY=
